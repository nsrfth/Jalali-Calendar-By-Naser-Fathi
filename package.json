		"test:watch": "vitest",
		"test:parity": "node scripts/check-jalali-parity.mjs",
		"generate:holidays": "node scripts/generate-ir-holidays.mjs"
	},
	"dependencies": {
		"@mdi/js": "^7.4.47",
		"@nextcloud/auth": "^2.6.0",
		"@nextcloud/axios": "^2.6.0",
		"@nextcloud/cdav-library": "^2.6.2",
		"@nextcloud/dialogs": "^7.4.1",
		"@nextcloud/initial-state": "^3.0.0",
		"@nextcloud/l10n": "^3.4.1",
		"@nextcloud/router": "^3.1.0",
		"@nextcloud/vue": "^9.9.0",
		"ical.js": "^2.2.1",
		"jalaali-js": "^2.0.0",
		"vue": "^3.5.39"
	},
	"devDependencies": {
		"@nextcloud/browserslist-config": "^3.1.2",
		"@nextcloud/vite-config": "^2.5.4",
		"@vue/test-utils": "^2.4.6",
		"browserslist": "^4.26.3",
		"jsdom": "^25.0.1",
		"sass": "^1.83.0",
		"shamsi-holidays": "^1.0.5",
		"typescript": "^5.9.3",
		"vite": "^7.3.6",
		"vitest": "^3.2.4"
	},
	"browserslist": [
		"extends @nextcloud/browserslist-config"
